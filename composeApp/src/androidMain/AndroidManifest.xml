<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════════
         BLE Permissions
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Android 12+ (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31" />

    <!-- Android 11 и ниже (API ≤ 30) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- ═══════════════════════════════════════════════════════════════════
         Location Permissions
         Требуется для BLE-сканирования (Android ≤ 12) и Wi-Fi Direct
         peer discovery (Android ≤ 12). На Android 13+ заменяется
         NEARBY_WIFI_DEVICES для Wi-Fi Direct.
         ═══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ═══════════════════════════════════════════════════════════════════
         Wi-Fi Direct (P2P) Permissions
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Базовые Wi-Fi разрешения — обязательны для Wi-Fi Direct -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        NEARBY_WIFI_DEVICES (Android 13+, API 33+):
        Заменяет ACCESS_FINE_LOCATION для Wi-Fi Direct peer discovery.
        ВАЖНО: НЕ используем neverForLocation здесь, потому что Wi-Fi Direct
        peer discovery МОЖЕТ использоваться для определения местоположения.
        Если вы уверены, что не используете его для геолокации — можно добавить
        android:usesPermissionFlags="neverForLocation", но тогда нужно явно
        указать это в Privacy Policy.
    -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        tools:targetApi="33" />

    <!-- ═══════════════════════════════════════════════════════════════════
         Media / Storage Permissions
         ═══════════════════════════════════════════════════════════════════ -->
    <!-- Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:targetApi="33" />
    <!-- Android 12 и ниже -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ═══════════════════════════════════════════════════════════════════
         Hardware Feature Declarations
         ═══════════════════════════════════════════════════════════════════ -->
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- Wi-Fi Direct — не обязателен, чтобы не блокировать установку -->
    <uses-feature android:name="android.hardware.wifi.direct"
        android:required="false" />

    <application
        android:name="com.meshovik.MeshovikApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name="com.meshovik.presentation.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
